# Copy to .env and fill in real keys. .env is gitignored.

# W&B (Weights & Biases) — used for experiment tracking inside Kaggle kernels.
# Generate at https://wandb.ai/settings (key starts with wandb_v1_).
WANDB_API_KEY=

# Kaggle — new API token format (starts with KGAT_).
# Generate at https://www.kaggle.com/settings → API → "Create New Token".
KAGGLE_API_TOKEN=

# NVIDIA NIM — build.nvidia.com / integrate.api.nvidia.com.
# Key starts with nvapi-. Single key covers GLM 5.2 and MiniMax M3 on NIM.
NIM_API_KEY=

# OpenCode Zen — https://opencode.ai/zen
# Key starts with sk-. Used for free DeepSeek V4 Flash Free primary.
OPENCODE_ZEN_API_KEY=
