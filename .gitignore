*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local artifacts
artifacts/
*.log

# Local-only research dumps
.firecrawl/

