diff --git a/.github/workflows/opencode-ml-agent.yml b/.github/workflows/opencode-ml-agent.yml
index 4b7e500..654ab56 100644
--- a/.github/workflows/opencode-ml-agent.yml
+++ b/.github/workflows/opencode-ml-agent.yml
@@ -51,6 +51,17 @@ jobs:
       WANDB_ENTITY: ${{ vars.WANDB_ENTITY }}
       WANDB_PROJECT: ${{ vars.WANDB_PROJECT }}
       WANDB_SWEEP_ID: ${{ vars.WANDB_SWEEP_ID }}
+      # GPU-sweep context for this workflow. It is the ONLY workflow allowed to
+      # push a GPU sweep kernel, and until now it had no way to know which
+      # sweep to join - `WANDB_SWEEP_ID` is deliberately never set (ml-sweep-loop
+      # hard rule), so the handoff "push perpos-gpu-sweep-* with
+      # SWEEP_WANDB_SWEEP_ID=<id>" was structurally impossible for every cycle
+      # since the GPU sweep existed. Resolved in the "Resolve designated sweep"
+      # step below; the repo variable is kept only as a fallback because the job
+      # token cannot write it (HTTP 403).
+      SWEEP_WANDB_ENTITY: ${{ vars.SWEEP_WANDB_ENTITY }}
+      SWEEP_WANDB_PROJECT: ${{ vars.SWEEP_WANDB_PROJECT }}
+      SWEEP_REPO_VAR_SWEEP_ID: ${{ vars.SWEEP_WANDB_SWEEP_ID }}
       # Private repo credentials for the runtime checkout.
       PRIVATE_REPO_URL: https://github.com/Reqeique/autonomous-ml-agent-private.git
       PRIVATE_REPO_BRANCH: main
@@ -86,6 +97,32 @@ jobs:
           echo "Final workspace tree (top-level):"
           ls -A
 
+      - name: Resolve designated sweep
+        run: |
+          set -euo pipefail
+          POINTER="$GITHUB_WORKSPACE/.github/sweep-designated.json"
+          RESOLVED=""; SRC=""
+          if [ -f "$POINTER" ]; then
+            RESOLVED=$(python -c "import json,sys;print(json.load(open(sys.argv[1])).get('sweep_id','') or '')" "$POINTER" 2>/dev/null || true)
+            [ -n "$RESOLVED" ] && SRC=".github/sweep-designated.json"
+          fi
+          if [ -z "$RESOLVED" ] && [ -n "${SWEEP_REPO_VAR_SWEEP_ID:-}" ]; then
+            RESOLVED="$SWEEP_REPO_VAR_SWEEP_ID"; SRC="repo variable"
+          fi
+          if [ -z "$RESOLVED" ]; then
+            RESOLVED=$(python -c "import json;print(json.load(open('state/sweep_state.json')).get('sweep_id','') or '')" 2>/dev/null || true)
+            [ -n "$RESOLVED" ] && SRC="state/sweep_state.json"
+          fi
+          if [ -z "$RESOLVED" ]; then
+            echo "::warning::no designated GPU sweep id resolvable; a GPU sweep kernel push will not be able to join a sweep."
+          else
+            if [ "${SWEEP_REPO_VAR_SWEEP_ID:-<unset>}" != "$RESOLVED" ]; then
+              echo "::warning::repo variable SWEEP_WANDB_SWEEP_ID=${SWEEP_REPO_VAR_SWEEP_ID:-<unset>} is stale; designated GPU sweep is $RESOLVED (from $SRC)."
+            fi
+            echo "Designated GPU sweep: $RESOLVED  (source: $SRC)"
+            echo "SWEEP_WANDB_SWEEP_ID=$RESOLVED" >> "$GITHUB_ENV"
+          fi
+
       - name: Pre-install tooling
         run: |
           python -m pip install --quiet --upgrade kaggle wandb
@@ -293,7 +330,7 @@ jobs:
                       try:
                           hits += cur.execute(
                               f"SELECT COUNT(*) FROM {tbl} WHERE {col} LIKE ?",
-                              ('%ml-sweep-loop%',)).fetchone()[0]
+                              ('%ml-training-loop%',)).fetchone()[0]
                       except Exception:
                           pass
               print(hits)
@@ -306,8 +343,8 @@ jobs:
             exit 0
           fi
           if [ "${HITS:-0}" -ge 1 ]; then
-            echo "Skill usage confirmed: ml-sweep-loop present ($HITS hit(s)) in $DB."
+            echo "Skill usage confirmed: ml-training-loop present ($HITS hit(s)) in $DB."
           else
-            echo "::error::ml-sweep-loop skill was NOT loaded during this run."
+            echo "::error::ml-training-loop skill was NOT loaded during this run."
             exit 1
           fi
